{
  "name": "keurdeco",
  "private": true,
  "version": "1.0.0",
  "description": "Keur Déco : idées de décoration africaine (www.keurdeco.com)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && PANGOCAIRO_BACKEND=fc FONTCONFIG_FILE=\"$PWD/assets/polices/fonts.conf\" node scripts/epingles.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "images": "node scripts/images.ts",
    "epingles": "PANGOCAIRO_BACKEND=fc FONTCONFIG_FILE=\"$PWD/assets/polices/fonts.conf\" node scripts/epingles.ts",
    "hotspots": "node scripts/hotspots.mjs",
    "nouvel-article": "node scripts/nouvel-article.mjs",
    "pinterest:auth": "node scripts/pinterest-auth.mjs",
    "pinterest:publier": "node scripts/pinterest-publier.mjs",
    "verifier-produits": "node scripts/verifier-produits.mjs",
    "vignettes": "node scripts/vignettes-produits.ts",
    "visuels-marque": "PANGOCAIRO_BACKEND=fc FONTCONFIG_FILE=\"$PWD/assets/polices/fonts.conf\" node scripts/visuels-marque.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "marked": "^18.0.14",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0"
  }
}
